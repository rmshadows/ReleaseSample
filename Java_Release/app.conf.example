# 通用 Java 应用打包配置。复制为 app.conf 后按项目改。
# 等号两边不要空格。路径相对项目根（本文件夹的上一级）。
# 把整个 pack2 文件夹拷到任意 Maven 项目里即可（可改名为 pack）。

# 必填
APP_NAME=MyApp
MAIN_CLASS=com.example.Main
MAVEN_JAR=target/myapp.jar

# 显示信息
VENDOR=example
APP_DESCRIPTION=My Java application

# 版本（三选一，靠前优先）：
# 1) 写死
VERSION=
# 2) 从 Java 源码读  VERSION = "x.y"
VERSION_JAVA=
# 3) 都留空：读 pom.xml 里 <parent> 之后第一条 <version>

# Linux 包名（小写、无空格）。留空则用 APP_NAME 转小写
LINUX_PKG_NAME=

# 图标（没有就用 jpackage 默认 Java 图标）
ICON_PNG=other/icon.png
ICON_ICO=other/icon.ico
ICON_ICNS=other/icon.icns

# jpackage --add-modules（Swing 桌面应用默认够用，按项目加减）
JP_MODULES=java.base,java.desktop,java.datatransfer,java.prefs,jdk.charsets

# 传给 jpackage 的 --java-options（一条）
JAVA_OPTIONS=-Dfile.encoding=UTF-8

# Linux 桌面菜单分组
MENU_GROUP=Utility
